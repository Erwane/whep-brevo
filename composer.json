{
    "name": "erwane/whep-brevo",
    "description": "Brevo (SendInBlue) webhooks handler",
    "type": "library",
    "keywords": [
        "webhook",
        "brevo",
        "sendinblue"
    ],
    "homepage": "https://github.com/Erwane/whep-brevo",
    "support": {
        "issues": "https://github.com/Erwane/whep-brevo/issues",
        "source": "https://github.com/Erwane/whep-brevo"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Erwane",
            "email": "erwane@phea.fr",
            "homepage": "https://erwane-breton.fr"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "erwane/whep-client": "^2.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "erwane/phpunit-resource-helper": "^2.0",
        "phpunit/phpunit": "^10.0 | ^12.0",
        "symfony/var-dumper": "^v6.0 | ^v7.0"
    },
    "autoload": {
        "psr-4": {
            "WHEP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WHEP\\Test\\": "tests/"
        }
    },
    "config": {
        "platform-check": true,
        "sort-packages": true,
        "prefered-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cscheck": "php vendor/bin/phpcs -p -s src tests",
        "csfix": "php vendor/bin/phpcbf src tests"
    }
}
